{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Platter",
  "version": "0.2.0",
  "identifier": "com.kolebaev.platter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Platter",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "resources": {
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../LICENSES/": "LICENSES/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "category": "Music",
    "shortDescription": "Manage music on a click-wheel iPod Classic",
    "publisher": "Ilia Kolebaev",
    "copyright": "Copyright © 2026 Ilia Kolebaev"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/kolebayev/platter/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4ODAyNkM3QzQyNjczMDkKUldRSmN5YkV4eWFBNklHY3dkZzh0SFhwMjV2dmpxRktJMU5IY2JWTVE5aG1lb2ZZcW0rSGRGS00K"
    }
  }
}
